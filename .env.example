# ========================================================
# Kredo.ai Environment Configuration
# ========================================================

# 1. MongoDB Database Connection
# To connect to MongoDB Atlas Cloud Cluster:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kredo_db?retryWrites=true&w=majority
# To connect to local MongoDB:
# MONGO_URI=mongodb://localhost:27017/
MONGO_URI=mongodb://localhost:27017/

# 2. Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# 3. Optional: Google Gemini API Key for Credit Copilot
# GEMINI_API_KEY=AIzaSy...
